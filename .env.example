# ---- 大模型（任意 OpenAI 兼容接口）----
# 阿里云百炼（北京）：业务空间专属域名，Key 只能配这个业务空间的地址（各地域 Key 不通用，换地域会 401）
LLM_API_KEY=sk-xxxx
LLM_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-flash
LLM_ENABLE_THINKING=0          # 千问 3.x 默认开思考：慢 1-3 秒/轮，且多轮工具调用要回传思考内容

# 其他厂商只需换 base_url 和模型名（模型名以各家官方文档为准，需选支持 function calling 的模型），并删掉 LLM_ENABLE_THINKING：
# DeepSeek:  https://api.deepseek.com              (deepseek-flash)
# 百炼共享域名: https://dashscope.aliyuncs.com/compatible-mode/v1
# Kimi:      https://api.moonshot.cn/v1
# 智谱:      https://open.bigmodel.cn/api/paas/v4

# ---- 可选 ----
# SZU_AGENT_HOME=~/.szu-agent   # 登录凭证、用户画像的存放目录
# SZU_ELECTRIC_PAY_URL=...      # 电费充值卡片二维码指向的入口（默认：校园卡服务大厅）。程序会自动去掉 openid、code、encrypt_code 等个人参数
