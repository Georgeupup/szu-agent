# 复制成服务器上项目目录里的 .env，权限 600（chmod 600 .env）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# 多人模式
SZU_AGENT_MULTIUSER=1
# 服务器密钥：python3 -c "import secrets;print(secrets.token_hex(32))" 生成。部署后不要换、要备份
SZU_AGENT_SECRET=
# 第一次登录后打开 /api/me，把自己的 userId 填进来，就能看 /usage
SZU_AGENT_ADMINS=
# 用域名 + HTTPS 对外开放时再打开（SSH 隧道测试时不用）
# SZU_AGENT_COOKIE_SECURE=1
