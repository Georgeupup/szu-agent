# 荔园助手演示站：演示数据（--mock）、单人模式、独立数据目录。Nginx 把公网 80 端口转给它。
# 和真实服务共用同一个 .env，所以多人模式开关绝不能写进 .env（会让演示站也要求学校登录）
[Unit]
Description=szu-agent demo
After=network-online.target

[Service]
User=szu
WorkingDirectory=/home/szu/szu-agent
Environment=SZU_AGENT_HOST=127.0.0.1
Environment=SZU_AGENT_PORT=8001
Environment=SZU_AGENT_HOME=/home/szu/.szu-agent-demo
ExecStart=/home/szu/.local/bin/uv run --no-sync szu-agent-web --mock
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
